# =============================================================================
# EMPLOYEE MANAGEMENT WEB — ENVIRONMENT CONFIGURATION
#
# IMPORTANT — how this differs from the backend's .env:
# Angular is a browser SPA — there is no server process reading process.env
# at request time, so a .env file cannot be read live by the running app.
# Instead: `npm run generate-env` (auto-run before `start`/`build` via
# pre-hooks) reads THIS file and writes it into
# src/environments/environment.ts / environment.prod.ts as a plain TS object
# at BUILD TIME. Copy this file to `.env`, edit it, then (re)build — the
# toggle takes effect on the next build/serve, not by editing running code.
# =============================================================================

# ---------- API connection ----------
API_BASE_URL=http://localhost:3000/api/v1

# ---------- Feature toggles ----------
LOGGING_ENABLED=true            # console logging of HTTP errors / auth events
PRODUCTION=false                # mirrors Angular's environment.production flag

# ---------- Pagination (kept in sync with backend PAGINATION_DEFAULT_LIMIT) ----------
PAGINATION_DEFAULT_LIMIT=10

# ---------- Auth ----------
AUTH_TOKEN_STORAGE_KEY=emp_mgmt_access_token
AUTH_REFRESH_STORAGE_KEY=emp_mgmt_refresh_token
# When true, the app skips the login screen and injects a fake bearer token
# for local UI development against a backend running with JWT_BYPASS=true.
# Mirrors the backend's JWT_BYPASS flag — keep them in sync, and NEVER set
# this true for anything other than local development.
AUTH_BYPASS=false

# ---------- Debounce / UX tuning ----------
SEARCH_DEBOUNCE_MS=400
