# =============================================================================
# EMPLOYEE MANAGEMENT API — ENVIRONMENT CONFIGURATION
# Copy this file to `.env` and adjust values. Every feature below is toggled
# ON/OFF via env vars so the same codebase behaves differently per environment
# without code changes. ALL variables are validated at boot (see
# src/config/env.validation.ts) — the app refuses to start if one is missing
# or malformed, rather than failing silently at runtime.
# =============================================================================

# ---------- App ----------
NODE_ENV=development                 # development | test | production
PORT=3000
API_PREFIX=api
API_VERSION=v1
APP_URL=http://localhost:3000

# ---------- Database ----------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=employee-nestjs-api
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=2
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# ---------- JWT / Auth ----------
JWT_SECRET=CHANGE_ME_super_secret_access_token_key
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_super_secret_refresh_token_key
JWT_REFRESH_EXPIRES_IN=7d
# DANGER: when true, ALL auth guards are bypassed and every request is treated
# as an authenticated admin user. Only ever true on a local dev machine, never
# in any shared or deployed environment. The app hard-refuses to boot with
# this true when NODE_ENV=production (see env.validation.ts).
JWT_BYPASS=false

# ---------- RBAC ----------
# When false, RolesGuard allows every authenticated request regardless of role
# (useful for local development without seeding multiple role accounts).
RBAC_ENABLED=true

# ---------- Logging ----------
LOGGING_ENABLED=true                 # false = minimal console logging only, no pino/JSON pipeline
LOG_LEVEL=info                       # trace | debug | info | warn | error | fatal
LOG_PRETTY=true                      # true = human-readable in dev; set false in prod for raw JSON
LOG_REDACT_FIELDS=req.headers.authorization,password,refreshToken,salary

# ---------- Swagger / API docs ----------
SWAGGER_ENABLED=true                 # recommend false (or gate behind auth) in production
SWAGGER_PATH=api/docs

# ---------- Rate limiting (Throttler) ----------
THROTTLE_ENABLED=true
THROTTLE_TTL=60                      # seconds
THROTTLE_LIMIT=100                   # requests per TTL window, general routes
AUTH_THROTTLE_TTL=60
AUTH_THROTTLE_LIMIT=5                # tighter limit on /auth/* to blunt credential stuffing

# ---------- CORS ----------
CORS_ENABLED=true
CORS_ORIGIN=http://localhost:4200    # comma-separated list for multiple origins
CORS_CREDENTIALS=true

# ---------- Request body limits ----------
MAX_REQUEST_BODY_SIZE=1mb

# ---------- Pagination defaults ----------
PAGINATION_DEFAULT_PAGE=1
PAGINATION_DEFAULT_LIMIT=10
PAGINATION_MAX_LIMIT=100

# ---------- Health checks ----------
HEALTH_ENABLED=true

# ---------- Seed script ----------
SEED_ENABLED=true                    # safety switch; script refuses to run if false
SEED_EMPLOYEE_COUNT=50
SEED_FORCE=false                     # when true, clears existing employees/users before seeding
SEED_ADMIN_EMAIL=admin@company.com
SEED_ADMIN_PASSWORD=Admin@12345
SEED_HR_EMAIL=hr@company.com
SEED_HR_PASSWORD=HrUser@12345
